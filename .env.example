# GROQ_API_KEY: Chave gratuita da API Groq (https://console.groq.com) para rodar o cérebro LLM localmente sem custo.
GROQ_API_KEY=""

# GROQ_MODEL: Modelo gratuito padrão na Groq (opções: llama-3.3-70b-versatile, llama-3.1-8b-instant).
GROQ_MODEL="llama-3.3-70b-versatile"

# OLLAMA_BASE_URL: Opcional — caso deseje rodar um modelo 100% offline via Ollama (ex: http://127.0.0.1:11434).
OLLAMA_BASE_URL=""
OLLAMA_MODEL="llama3.2"

# GEMINI_API_KEY: Usada automaticamente apenas como fallback de demonstração em nuvem quando GROQ_API_KEY não estiver definida.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: URL base da aplicação.
APP_URL="http://localhost:3000"

# GOOGLE_MAPS_PLATFORM_KEY: Chave da API do Google Maps Platform para mapas interativos, lugares e rotas.
GOOGLE_MAPS_PLATFORM_KEY=""

